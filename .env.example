# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Configuration (Prisma connection string)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_backend?schema=public"

# Redis Configuration (Used for caching, event bus, and background queues)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL="redis://127.0.0.1:6379"

# Auth / JWT Configuration (Secrets must be at least 32 characters long)
JWT_ACCESS_SECRET="generate_at_least_32_characters_secret_key_here"
JWT_REFRESH_SECRET="generate_another_at_least_32_characters_secret_key_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AWS S3 / Cloudflare R2 Storage (Used for profile avatars)
S3_REGION="auto"
S3_BUCKET_NAME="base-backend-avatars"
S3_ACCESS_KEY_ID="your_access_key_id"
S3_SECRET_ACCESS_KEY="your_secret_access_key"
S3_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
S3_PUBLIC_URL="https://pub-your_public_bucket_url.r2.dev"
S3_AVATAR_BUCKET="avatars"

# OAuth Integration Configurations
GOOGLE_CLIENT_ID="google_oauth_client_id"
GOOGLE_CLIENT_SECRET="google_oauth_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

GITHUB_CLIENT_ID="github_oauth_client_id"
GITHUB_CLIENT_SECRET="github_oauth_client_secret"
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"

# Email Configuration (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="smtp_username"
SMTP_PASS="smtp_password"
EMAIL_FROM="noreply@basebackend.com"

# Background Queue Configuration
QUEUE_NAME="default_queue"
WORKER_CONCURRENCY=5
